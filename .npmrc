# Flat node_modules (npm/yarn-classic style). Needed so the local file: deps
# from callback-box (agent-doctest, personal-vibe-check) can resolve their peer
# imports (@tapjs/core, tap, ...) from this project's node_modules rather than
# from the callback-box checkout, which has none installed.
node-linker=hoisted
# Silence the punycode DEP0040 warning from transitive deps on every node run.
node-options=--disable-warning=DEP0040
