{
  "name": "intra-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "tsx build.ts --serve",
    "build": "tsx build.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tap",
    "test:watch": "tap --watch",
    "playtest": "tsx playtest/playthrough.ts",
    "playtest:record": "tsx playtest/record.ts",
    "lint:fix": "eslint . --fix",
    "lint:oxlint": "oxlint -A no-unused-vars",
    "lint:circular": "madge --circular --extensions ts,tsx lib app components",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@preact/signals": "^1.3.0",
    "@preact/signals-core": "^1.14.4",
    "@preact/signals-react": "^2.2.0",
    "just-clone": "^6.2.0",
    "just-compare": "^2.3.0",
    "just-shuffle": "^4.2.0",
    "just-sort-by": "^3.2.0",
    "openai": "^4.104.0",
    "react": "^18",
    "react-dom": "^18",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260724.1",
    "@ianbicking/personal-vibe-check": "file:../../../workspace/callback-box/personal-vibe-check",
    "@preact/signals-react-transform": "^0.4.0",
    "@tapjs/core": "^4.5.8",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "agent-doctest": "file:../../../workspace/callback-box/agent-doctest",
    "esbuild": "^0.20.2",
    "eslint": "^9.39.5",
    "knip": "^6.29.0",
    "madge": "^8.0.0",
    "oxlint": "^1.75.0",
    "playwright": "^1.62.0",
    "postcss": "^8",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.1",
    "tap": "^21.7.4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "wrangler": "^4.114.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
