{
  // Cloudflare Workers deployment for the game.
  //
  // The game is a static single-page app, so this is an assets-only Worker:
  // there is no `main` script, Cloudflare just serves ./dist. The engine runs
  // in the browser and talks to OpenRouter directly.
  //
  // If the engine later moves server-side (so play doesn't depend on a
  // browser-held API key), add `"main": "worker/index.ts"` here and the same
  // deployment grows a server without changing how assets are served.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "intra-game",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-06",
  "compatibility_flags": ["nodejs_compat"],
  // One Durable Object per game session: it owns the append-only event log and
  // runs the engine, and DOs serialize requests so turns cannot interleave.
  "durable_objects": {
    "bindings": [{ "name": "GAME_SESSION", "class_name": "GameSession" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameSession"] }],
  // Cloudflare Access gates /api/*; empty here means the API fails closed (404
  // "not configured") until a deployment fills these in.
  "vars": { "ACCESS_TEAM_DOMAIN": "", "ACCESS_AUD": "" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Two client-side routes (/ and /openrouter) served from one HTML shell.
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
