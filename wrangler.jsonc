{
  // Cloudflare Workers deployment for the game.
  //
  // One Worker serves both halves: Cloudflare serves the client bundle from
  // ./dist directly, and worker/index.ts handles /api/* and /auth/*. The bundle
  // is only a view; the engine runs in a Durable Object, so every turn is a
  // request to this Worker.
  //
  // Secrets are NOT here. CF_AIG_TOKEN is set with `wrangler secret put` (or in
  // the dashboard); CF_ACCOUNT_ID and GATEWAY_MODEL are plain vars that a
  // deployment fills in. See docs/deploying.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "intra-game",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-06",
  "compatibility_flags": ["nodejs_compat"],
  // One Durable Object per game session: it owns the append-only event log and
  // runs the engine, and DOs serialize requests so turns cannot interleave.
  // Plus one per player, holding the list of their games — a DO namespace
  // cannot be enumerated, so that list has to be kept somewhere.
  "durable_objects": {
    "bindings": [
      { "name": "GAME_SESSION", "class_name": "GameSession" },
      { "name": "PLAYER_SESSIONS", "class_name": "PlayerSessions" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameSession"] },
    { "tag": "v2", "new_sqlite_classes": ["PlayerSessions"] },
  ],
  // Non-secret configuration lives here rather than in the dashboard, so a
  // deployment is reproducible from the repo and nothing has to be re-entered
  // by hand. Note that `wrangler deploy` makes this file authoritative: a var
  // set in the dashboard is overwritten on the next deploy. Secrets are a
  // separate store and are never touched by it.
  //
  // GOOGLE_CLIENT_ID is public by design — it appears in the authorize URL in
  // every player's browser. Its secret is set with `wrangler secret put`.
  //
  // Empty ACCESS_* means the API fails closed (404 "not configured") unless
  // Google sign-in is configured instead; see docs/deploying.md §5.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "GOOGLE_CLIENT_ID": "369663211714-da9tf8klvfs450kea9ji0rtsk00it7hd.apps.googleusercontent.com",
    // The gateway's name is part of its URL, so it is configuration rather
    // than a label. The account id is an identifier that appears in those
    // URLs; the token that actually authorises anything is a secret.
    "CF_ACCOUNT_ID": "bb530e5839d03156b34799ccb702c28a",
    "CF_GATEWAY_ID": "intra",
    // The model server-side play runs on, in provider/model form.
    //
    // 26/26, the same as gpt-5.4-nano scored the day this replaced it, while
    // being 35% faster over the suite (171s against 264s) and 29% cheaper
    // (593 turns per dollar against 423). The score is a tie at the ceiling —
    // both pass everything, and a single run moves by one either way — so the
    // reason to prefer it is the latency and the bill, which are not close.
    //
    // What drives both: it thinks less for the same answer. 4,953 reasoning
    // tokens over the suite against 10,467, and those are billed at the output
    // rate. See evals/RESULTS.md.
    //
    // Only worth running at all because OpenAI cut its price 80% on
    // 2026-07-30, from $1.00/$6.00 to the same input price as the nano it
    // replaces.
    //
    // OpenAI is a native AI Gateway provider, so this runs through the gateway
    // and keeps its spend caps and logs. GLM scored well and is far cheaper
    // still, but AI Gateway has no Z.ai provider, so it would mean bypassing
    // both.
    "GATEWAY_MODEL": "openai/gpt-5.6-luna",
    // The "flash" tier: prompts that declare model: "flash" (today only
    // "describe people", the one prose-not-tags prompt in the game) run here
    // instead of GATEWAY_MODEL. Atmosphere, not canon, so it gets the
    // cheapest fast model on the gateway: this exact id was production until
    // 2026-07-30, so it is known-good through this gateway. Its protocol
    // weakness (needed reasoning "medium" to emit tags reliably) does not
    // apply to prose. Note the usage meter prices flash calls at the
    // GATEWAY_PRICE rates below, which overcounts them slightly — the safe
    // direction for the quota.
    "GATEWAY_FLASH_MODEL": "openai/gpt-5.4-nano",
    // Deliberately unset, where gpt-5.4-nano needed "medium" to get from 21/26
    // to 25/26. Measured on this model rather than assumed: "medium" scores the
    // same 26/26, takes 35s longer and costs more, because the only thing it
    // changes is how long it thinks.
    //
    // "GATEWAY_REASONING": "medium",
    // Dollars per million tokens for the model above. AI Gateway reports token
    // counts but no price, and the quota is denominated in dollars — without
    // these every turn meters at zero and the limit never fires. Update them
    // when GATEWAY_MODEL changes.
    //
    // OpenAI's published standard rate as of 2026-07-30, the day they were cut
    // — so treat them as unconfirmed until a day of real traffic has been
    // compared against the gateway's own spend figures. A price set too low
    // here does not fail loudly: it meters every turn at a fraction of what it
    // cost, and QUOTA_USD below silently stops meaning what it says.
    //
    // Two other rate cards exist for the same model and neither is this one.
    // OpenAI's flex tier is half of standard, and OpenRouter currently bills
    // this model at exactly that — which is why the eval's dollar figures are
    // about half what a turn costs here. Do not copy numbers from evals/
    // RESULTS.md into these fields.
    //
    // The backstop that does not depend on getting this right is a spend limit
    // on the gateway itself; see docs/deploying.md.
    "GATEWAY_PRICE_IN": "0.20",
    "GATEWAY_PRICE_OUT": "1.20",
    // Dollars per player per rolling 30 days of server play. A player using
    // their own key isn't metered; see worker/quota.ts. About 590 turns at the
    // prices above — 16 player turns of the eval suite came to $0.027 when
    // its recorded token counts are priced at OpenAI's standard rate — which
    // is as accurate as those prices are.
    "QUOTA_USD": "1",
    "QUOTA_PERIOD_DAYS": "30",
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // One client-side route, but the shell still answers unmatched paths.
    "not_found_handling": "single-page-application",
    // Without this, a *navigation* to /auth/login never reaches the Worker.
    //
    // The asset layer runs first and single-page-application handling answers
    // any unmatched path with index.html — but only for requests that look like
    // browser navigation. A fetch() sends Sec-Fetch-Mode: cors and falls
    // through to the Worker, so every API call worked and every test passed;
    // clicking "Sign in" navigated, got the game shell back, and looked exactly
    // like a page reload that did nothing.
    "run_worker_first": ["/api/*", "/auth/*"],
  },
  "observability": {
    "enabled": true,
  },
}
